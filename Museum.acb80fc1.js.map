'use strict';
// slider
var count = 0;
var width;
var timer;
var sliderImages = document.querySelectorAll('.slider__image');
var sliderLine = document.querySelector('.slider__line');
var sliderDots = document.querySelectorAll('.slider__dot');
var gap = 20; // gaps are equal to pageGrid column gap according to design < 640
var halfGap;
if (window.innerWidth >= 640) {
    gap = 30;
    halfGap = gap / 2;
}
function init() {
    width = document.querySelector('.slider').offsetWidth;
    sliderLine.style.width = width * sliderImages.length + gap * (sliderImages.length - 1) + 'px';
    sliderImages.forEach(function(item) {
        item.style.width = width + 'px';
    });
    if (window.innerWidth >= 640) {
        sliderLine.style.width = (width / 2 - halfGap) * sliderImages.length + gap * (sliderImages.length - 1) + 'px';
        sliderImages.forEach(function(item) {
            item.style.width = width / 2 - halfGap + 'px';
        });
    }
    rollSlider();
}
window.addEventListener('resize', init());
init();
function rollSlider() {
    sliderLine.style.transform = 'translate(-' + (count * width + count * gap) + 'px)';
    if (window.innerWidth >= 640) sliderLine.style.transform = 'translate(-' + (count * (width / 2 - halfGap) + count * gap) + 'px)';
}
function thisSlide(index) {
    sliderDots.forEach(function(item) {
        return item.classList.remove('slider__dot--active');
    });
    sliderDots[index].classList.add('slider__dot--active');
}
function autoSlider() {
    timer = setTimeout(function() {
        count++;
        var si = sliderImages.length;
        if (window.innerWidth >= 640) si = sliderImages.length - 1;
        if (count >= si) count = 0;
        thisSlide(count);
        rollSlider();
        autoSlider();
    }, 3000);
}
autoSlider();
sliderDots.forEach(function(dot, index) {
    dot.addEventListener('click', function() {
        clearTimeout(timer);
        count = index;
        thisSlide(count);
        rollSlider();
        setTimeout(autoSlider, 3000);
    });
});
// animation on scroll
var animated = document.querySelectorAll('.animated');
function onScrollAnimation() {
    for(var i = 0; i < animated.length; i++){
        var windowHeight = window.innerHeight;
        var elementTop = animated[i].getBoundingClientRect().top;
        var elementVisible = 180;
        if (elementTop < windowHeight - elementVisible) animated[i].classList.add('active');
        else animated[i].classList.remove('active');
    }
}
window.addEventListener('scroll', function() {
    return onScrollAnimation();
});

